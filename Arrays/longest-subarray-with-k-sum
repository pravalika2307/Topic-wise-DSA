def longest_subarray(arr, k):
    n = len(arr)
    for i in range(n):
        for j in range(i, n):

             n = len(arr) 
        maxLength = 0

        currentSum = 0
        for i in range(i, j + 1):
            currentSum += arr[i]

            if currentSum == k:
                maxLength = max(maxLength, j - i + 1)

        return maxLength
arr = list(map(int, input().split()))
