def max_sub_array(arr):
    # maximum sum
    maxi = float('-inf') 
    sum = 0 
    for i in range(len(arr)):
        sum += arr[i] 
        if sum > maxi:
            maxi = sum 
        if sum < 0:
            sum = 0 
        
    return maxi

arr = list(map(int, input().split()))
print(max_sub_array(arr))